# RideLens configuration.
# Copy to .env.local and fill in what you have. NEVER commit real credentials.
#
# RideLens runs with NONE of these set: the keyless OSM geocoder works out of
# the box. It will simply report every provider as unavailable rather than show
# a price, which is the honest behaviour. See SETUP_REQUIRED.md.

# ---------------------------------------------------------------- application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- persistence
# Required in production (startup check NO_DURABLE_PERSISTENCE).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------- quote source
# Obi Intelligent Pricing — the PRIMARY multi-provider feed (Uber, Lyft,
# Empower, Curb, Waymo). Requires a commercial agreement. See SETUP_REQUIRED.md.
OBI_API_KEY=
OBI_API_BASE_URL=https://api.rideobi.com

# Curb Flow — direct licensed taxi supply. Requires a partner agreement.
CURB_API_KEY=
CURB_API_BASE_URL=https://api.gocurb.com

# --- Uber -------------------------------------------------------------------
# WARNING: Uber's API Terms of Use §II B prohibit using the Uber API in a
# product that compares Uber against competing services. The direct Uber quote
# adapter therefore stays OFF unless you hold a written agreement granting
# comparison rights. Setting this to true is an assertion that you do.
# See docs/DATA_SOURCE_MATRIX.md §Uber before changing it.
UBER_COMPARISON_RIGHTS_GRANTED=false
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=
# Booking deep links only — NOT the restricted quote API. Without it RideLens
# degrades to a generic Uber handoff rather than claiming a prefill that will
# not happen.
UBER_DEEPLINK_CLIENT_ID=

# --- Lyft -------------------------------------------------------------------
# Lyft's public developer programme is closed; no new credentials can be
# created. These activate the adapter only under a partner agreement.
# LYFT_CLIENT_ID also enables the Lyft booking universal link.
LYFT_CLIENT_ID=
LYFT_CLIENT_SECRET=
LYFT_API_BASE_URL=https://api.lyft.com

# --- Empower ----------------------------------------------------------------
# Empower (the driver-owned rideshare platform) publishes no developer API.
# NOTE: this is NOT empower.com, the financial-services company.
EMPOWER_API_KEY=
EMPOWER_API_BASE_URL=

# ------------------------------------------------------------------- location
# auto | google | mapbox | osm | fixture
#   auto    google > mapbox > osm, based on what is configured
#   osm     keyless Nominatim + Photon. Live and permitted, but ~1 req/s.
#   fixture tests only — THROWS in production.
GEOCODER_PROVIDER=auto
LOCATION_PROVIDER_API_KEY=
NEXT_PUBLIC_MAP_KEY=
# Sent in the User-Agent to Nominatim/Photon, as their usage policy requests.
OSM_CONTACT_EMAIL=
ENABLE_ROUTE_GEOMETRY=true
# Road router used to measure the route drawn on the map. Defaults to the public
# OSRM demo instance. Self-host or buy one before carrying real traffic.
ROUTING_BASE_URL=
# Pedestrian router, used for the walk to and from a platform. Deliberately a
# SEPARATE setting: the OSRM demo server above has only the car profile loaded
# and answers a walking request with driving times (31 km/h, measured). Defaults
# to the public Valhalla instance, which has a real pedestrian graph.
WALKING_BASE_URL=

# ------------------------------------------------------------------ behaviour
# Prices move on surge cycles of tens of seconds. Keep the TTL short.
QUOTE_CACHE_TTL_SECONDS=20
QUOTE_REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=300

# Durable rate limiting. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32-byte base64 key. Without it, provider account linking stays disabled.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------- non-production only
# Deterministic fixture data for local demos and E2E. IGNORED in production:
# demoSourceActive requires NODE_ENV !== 'production'. Setting it in a
# production build raises the DEMO_SOURCE_IN_PRODUCTION startup error.
RIDELENS_DEMO_SOURCE=disabled
